---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<BaseLayout
  title="Terms & Conditions — QuoteFlow"
  description="You may browse quotes, customize posters, and download PNG images for personal or social sharing while respecting attribution and applicable copyright for sourced works."
  locale="en"
  alternateUrl="/id/terms/"
>
  <section class="section">
    <div class="container info-wrap">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Terms & Conditions' }]} />
      <article class="card info-card">
        <h1 class="heading-serif info-h1">Terms & Conditions</h1>
        <p class="info-p">You may browse quotes, customize posters, and download PNG images for personal or social sharing while respecting attribution and applicable copyright for sourced works.</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .info-wrap { max-width: 820px; }
  .info-card { padding: 2.25rem; }
  .info-h1 { font-size: clamp(1.8rem, 3vw, 2.35rem); margin-bottom: 1rem; }
  .info-p { color: var(--color-charcoal-muted); line-height: 1.75; }
</style>