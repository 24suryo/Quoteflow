---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<BaseLayout
  title="About Us — QuoteFlow"
  description="QuoteFlow is a bilingual inspirational quote generator and minimalist poster studio built for clarity, daily focus, and creative sharing in English and Bahasa Indonesia."
  locale="en"
  alternateUrl="/id/about/"
>
  <section class="section">
    <div class="container info-wrap">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'About QuoteFlow' }]} />
      <article class="card info-card">
        <h1 class="heading-serif info-h1">About QuoteFlow</h1>
        <p class="info-p">QuoteFlow is a bilingual inspirational quote generator and minimalist poster studio built for clarity, daily focus, and creative sharing in English and Bahasa Indonesia.</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .info-wrap { max-width: 820px; }
  .info-card { padding: 2.25rem; }
  .info-h1 { font-size: clamp(1.8rem, 3vw, 2.35rem); margin-bottom: 1rem; }
  .info-p { color: var(--color-charcoal-muted); line-height: 1.75; }
</style>