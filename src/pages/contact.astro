---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<BaseLayout
  title="Contact — QuoteFlow"
  description="Have feedback, translation suggestions, or attribution questions? Reach out to the QuoteFlow editorial team via hello@quoteflow.pages.dev."
  locale="en"
  alternateUrl="/id/contact/"
>
  <section class="section">
    <div class="container info-wrap">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Contact QuoteFlow' }]} />
      <article class="card info-card">
        <h1 class="heading-serif info-h1">Contact QuoteFlow</h1>
        <p class="info-p">Have feedback, translation suggestions, or attribution questions? Reach out to the QuoteFlow editorial team via hello@quoteflow.pages.dev.</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .info-wrap { max-width: 820px; }
  .info-card { padding: 2.25rem; }
  .info-h1 { font-size: clamp(1.8rem, 3vw, 2.35rem); margin-bottom: 1rem; }
  .info-p { color: var(--color-charcoal-muted); line-height: 1.75; }
</style>