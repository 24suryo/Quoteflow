---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getLatestArticles } from '../../utils/repository';
import type { Article } from '../../types';

export function getStaticPaths() {
  const articles = getLatestArticles(20);
  return articles.map((art) => ({
    params: { slug: art.slug.en },
    props: { article: art },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const alternateUrl = `/id/blog/${article.slug.id}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title.en,
  description: article.excerpt.en,
  datePublished: article.publishedAt,
  inLanguage: 'en',
};
---

<BaseLayout
  title={`${article.title.en} — QuoteFlow Journal`}
  description={article.excerpt.en}
  locale="en"
  alternateUrl={alternateUrl}
>
  <section class="section">
    <div class="container post-container">
      <Breadcrumb
        items={[
          { label: 'Home', href: '/' },
          { label: 'Journal', href: '/blog/' },
          { label: article.title.en },
        ]}
      />

      <article class="card post-card">
        <span class="post-meta">{article.publishedAt} · {article.readingTimeMinutes} min read</span>
        <h1 class="heading-serif post-title">{article.title.en}</h1>
        <p class="post-lead">{article.excerpt.en}</p>
        <div class="post-body">
          <p>{article.content.en}</p>
        </div>
      </article>

      <AdSlot locale="en" slotId="article-inline-slot" format="in-article" />
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    </div>
  </section>
</BaseLayout>

<style>
  .post-container { max-width: 820px; }
  .post-card { padding: 2.25rem; }
  .post-meta { font-size: 0.8rem; font-weight: 600; color: var(--color-gold-dark); }
  .post-title { font-size: clamp(1.8rem, 3.2vw, 2.4rem); margin-block: 0.65rem 1rem; }
  .post-lead { font-size: 1.08rem; color: var(--color-charcoal-muted); margin-bottom: 1.5rem; }
  .post-body p { font-size: 1rem; line-height: 1.75; }
</style>