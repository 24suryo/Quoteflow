---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<BaseLayout
  title="Privacy Policy — QuoteFlow"
  description="QuoteFlow stores your favorites, viewing history, and preferences locally in your browser using LocalStorage without requiring account registration. Future analytics and advertising placeholders respect applicable privacy standards."
  locale="en"
  alternateUrl="/id/privacy-policy/"
>
  <section class="section">
    <div class="container info-wrap">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Privacy Policy' }]} />
      <article class="card info-card">
        <h1 class="heading-serif info-h1">Privacy Policy</h1>
        <p class="info-p">QuoteFlow stores your favorites, viewing history, and preferences locally in your browser using LocalStorage without requiring account registration. Future analytics and advertising placeholders respect applicable privacy standards.</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .info-wrap { max-width: 820px; }
  .info-card { padding: 2.25rem; }
  .info-h1 { font-size: clamp(1.8rem, 3vw, 2.35rem); margin-bottom: 1rem; }
  .info-p { color: var(--color-charcoal-muted); line-height: 1.75; }
</style>