---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { UI_STRINGS } from '../../utils/i18n';

const locale: 'id' | 'en' = 'id';
const t: any = UI_STRINGS[locale] ?? UI_STRINGS.id ?? UI_STRINGS.en;
---

<BaseLayout
  title="QuoteFlow — Kata-Kata yang Menggerakkanmu Maju"
  description="Kutipan dwibahasa dan studio kutipan kustom."
  locale={locale}
  alternateUrl="/"
>
  <section class="qf-home-hero">
    <span class="qf-kicker">Studio Kutipan Dwibahasa</span>
    <h1 class="heading-serif">{t?.hero?.title ?? 'Kata-kata yang menggerakkanmu maju.'}</h1>
    <p>
      {t?.hero?.subtitle ?? 'Temukan kutipan pilihan atau susun kartu kutipan kustom sementara langsung di browser dalam Bahasa Inggris dan Bahasa Indonesia.'}
    </p>
    <div class="qf-home-actions">
      <a href="/id/generator/" class="qf-btn-primary">
        {t?.hero?.primaryCta ?? 'Buka Generator'}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .qf-home-hero {
    max-width: 780px;
    margin: 4rem auto;
    padding: 2.5rem 1.25rem;
    text-align: center;
  }

  .qf-kicker {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #4b5563;
    background: rgba(24, 28, 34, 0.06);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .qf-home-hero h1 {
    margin: 0 0 0.85rem;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.15;
    color: #181c22;
  }

  .qf-home-hero p {
    margin: 0 auto 1.75rem;
    max-width: 580px;
    font-size: 1rem;
    line-height: 1.65;
    color: #4b5563;
  }

  .qf-home-actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
  }

  .qf-btn-primary {
    display: inline-block;
    padding: 0.7rem 1.35rem;
    border-radius: 10px;
    background: #181c22;
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background 0.15s ease;
  }

  .qf-btn-primary:hover {
    background: #2c333e;
  }
</style>
