---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
---

<BaseLayout
  title="Kebijakan Privasi — QuoteFlow"
  description="QuoteFlow menyimpan daftar favorit, riwayat kutipan, dan preferensi secara lokal di peramban Anda (LocalStorage) tanpa mewajibkan pendaftaran akun. Integrasi analitik dan iklan ke depan mengikuti standar privasi yang berlaku."
  locale="id"
  alternateUrl="/privacy-policy/"
>
  <section class="section">
    <div class="container info-wrap">
      <Breadcrumb items={[{ label: 'Beranda', href: '/id/' }, { label: 'Kebijakan Privasi' }]} />
      <article class="card info-card">
        <h1 class="heading-serif info-h1">Kebijakan Privasi</h1>
        <p class="info-p">QuoteFlow menyimpan daftar favorit, riwayat kutipan, dan preferensi secara lokal di peramban Anda (LocalStorage) tanpa mewajibkan pendaftaran akun. Integrasi analitik dan iklan ke depan mengikuti standar privasi yang berlaku.</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .info-wrap { max-width: 820px; }
  .info-card { padding: 2.25rem; }
  .info-h1 { font-size: clamp(1.8rem, 3vw, 2.35rem); margin-bottom: 1rem; }
  .info-p { color: var(--color-charcoal-muted); line-height: 1.75; }
</style>