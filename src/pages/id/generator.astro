---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteGeneratorView from '../../components/QuoteGeneratorView.astro';
import EphemeralQuoteBox from '../../components/EphemeralQuoteBox.astro';
---

<BaseLayout
  title="Generator QuoteFlow — Pustaka & Studio Kustom"
  description="Jelajahi kutipan pilihan atau buat kartu kutipan kustom sementara."
  locale="id"
  alternateUrl="/generator/"
>
  <section class="qf-gen-header">
    <div class="qf-gen-badges">
      <span class="qf-tag">Pustaka Pilihan</span>
      <span class="qf-tag qf-tag-solid">Studio Kustom</span>
    </div>
    <h1 class="heading-serif">Generator Kutipan</h1>
    <p>
      Pilih kutipan dari pustaka atau susun kutipan kustom dengan latar belakang sementara secara langsung.
    </p>
  </section>

  <main class="qf-gen-grid" aria-label="Workspace Generator Kutipan">
    <section class="qf-panel">
      <div class="qf-panel-head">
        <span class="qf-step">01 • Pustaka</span>
        <h2>Kutipan Pilihan</h2>
      </div>
      <div class="qf-panel-body">
        <QuoteGeneratorView locale="id" />
      </div>
    </section>

    <section class="qf-panel">
      <div class="qf-panel-head">
        <span class="qf-step">02 • Studio Kustom</span>
        <h2>Kartu Kutipan Kustom</h2>
      </div>
      <div class="qf-panel-body">
        <EphemeralQuoteBox locale="id" />
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      const root = document.querySelector('.qf-panel');
      if (!root) return;

      const fallbackQuotes = [
        { text: 'Langkah kecil yang konsisten membangun momentum yang kokoh.', author: 'QuoteFlow' },
        { text: 'Kejelasan hadir saat kebisingan dikurangi.', author: 'QuoteFlow' },
        { text: 'Disiplin adalah memilih hal yang paling penting hari ini.', author: 'QuoteFlow' },
      ];
      let idx = 0;

      root.addEventListener('click', function (e) {
        const btn = e.target.closest('button');
        if (!btn) return;
        const label = (btn.textContent || '').toLowerCase();

        if (label.includes('new') || label.includes('shuffle') || label.includes('acak') || label.includes('kutipan baru')) {
          const quoteEl = root.querySelector('blockquote, [data-quote-text], .quote-text, #gen-quote-text');
          const authorEl = root.querySelector('[data-quote-author], .quote-author, #gen-quote-author, cite');
          const before = quoteEl ? quoteEl.textContent : '';
          setTimeout(() => {
            const after = quoteEl ? quoteEl.textContent : '';
            if (quoteEl && before === after) {
              idx = (idx + 1) % fallbackQuotes.length;
              quoteEl.textContent = fallbackQuotes[idx].text;
              if (authorEl) authorEl.textContent = '— ' + fallbackQuotes[idx].author;
            }
          }, 60);
        }

        if (label.includes('copy') || label.includes('salin')) {
          const quoteEl = root.querySelector('blockquote, [data-quote-text], .quote-text, #gen-quote-text');
          const textToCopy = quoteEl ? (quoteEl.textContent || '').trim() : '';
          if (textToCopy && navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(textToCopy).catch(() => {});
          }
        }
      });
    })();
  </script>
<!-- QF_ONLINE_FETCH_START -->
  <script is:inline>
    (function () {
      const panels = document.querySelectorAll('.qf-panel');
      const libraryPanel = panels && panels.length > 0 ? panels[0] : null;
      if (!libraryPanel) return;

      const targetContainer = libraryPanel.querySelector('.qf-panel-body') || libraryPanel;
      if (targetContainer.querySelector('.qf-online-bar')) return;

      const bar = document.createElement('div');
      bar.className = 'qf-online-bar';
      bar.style.cssText = 'display:flex;align-items:center;justify-content:space-between;gap:0.6rem;margin-bottom:0.9rem;flex-wrap:wrap;';

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'qf-online-btn';
      btn.textContent = '↻ Kutipan Baru';
      btn.style.cssText = 'padding:0.48rem 0.9rem;border-radius:8px;border:1px solid #181c22;background:#181c22;color:#ffffff;font-size:0.82rem;font-weight:600;cursor:pointer;transition:opacity 0.15s ease;';

      const status = document.createElement('span');
      status.className = 'qf-online-status';
      status.style.cssText = 'font-size:0.75rem;color:#6b7280;';
      status.textContent = 'dummyjson.com';

      bar.appendChild(btn);
      bar.appendChild(status);
      targetContainer.prepend(bar);

      const fallbackQuotes = [
          { quote: 'Momentum yang kokoh dibangun di jam-jam tenang saat tidak ada yang melihat.', author: 'QuoteFlow' },
          { quote: 'Kamu tidak butuh seluruh tangga—cukup satu langkah jujur berikutnya.', author: 'QuoteFlow' },
          { quote: 'Eksekusi yang tenang selalu mengalahkan usaha yang terburu-buru.', author: 'QuoteFlow' },
          { quote: 'Langkah kecil yang konsisten mengalahkan rencana besar yang tertunda.', author: 'QuoteFlow' }
        ];

      function applyQuoteToDom(quoteText, authorName) {
        const quoteEl = targetContainer.querySelector('blockquote, [data-quote-text], .quote-text, #gen-quote-text');
        const authorEl = targetContainer.querySelector('[data-quote-author], .quote-author, #gen-quote-author, cite');

        if (quoteEl) {
          quoteEl.textContent = '"' + quoteText + '"';
        }
        if (authorEl) {
          authorEl.textContent = '— ' + (authorName || 'QuoteFlow');
        }
      }

      async function handleFetchQuote() {
        btn.disabled = true;
        btn.style.opacity = '0.7';
        const originalText = btn.textContent;
        btn.textContent = 'Memuat...';

        try {
          const controller = new AbortController();
          const timeout = setTimeout(() => controller.abort(), 5000);

          const response = await fetch('https://dummyjson.com/quotes/random', {
            signal: controller.signal,
            headers: { Accept: 'application/json' },
          });
          clearTimeout(timeout);

          if (!response.ok) throw new Error('Request failed: ' + response.status);
          const payload = await response.json();

          if (!payload || !payload.quote) {
            throw new Error('Empty quote payload');
          }

          if ('id' === 'id') {
            const pick = fallbackQuotes[Math.floor(Math.random() * fallbackQuotes.length)];
            applyQuoteToDom(pick.quote, pick.author);
            status.textContent = 'Pustaka ID';
          } else {
            applyQuoteToDom(payload.quote, payload.author || 'QuoteFlow');
            status.textContent = 'Live';
          }
        } catch (err) {
          const pick = fallbackQuotes[Math.floor(Math.random() * fallbackQuotes.length)];
          applyQuoteToDom(pick.quote, pick.author);
          status.textContent = 'Pustaka ID';
        } finally {
          btn.disabled = false;
          btn.style.opacity = '1';
          btn.textContent = originalText;
        }
      }

      btn.addEventListener('click', handleFetchQuote);
    })();
  </script>
<!-- QF_ONLINE_FETCH_END -->
</BaseLayout>

<style>
  .qf-gen-header {
    max-width: 1200px;
    margin: 1.75rem auto 1rem;
    padding: 0 1rem;
    text-align: center;
  }

  .qf-gen-badges {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
    flex-wrap: wrap;
  }

  .qf-tag {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(24, 28, 34, 0.16);
    background: #ffffff;
    color: #181c22;
  }

  .qf-tag-solid {
    background: #181c22;
    color: #ffffff;
    border-color: #181c22;
  }

  .qf-gen-header h1 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.65rem, 3vw, 2.35rem);
    color: #181c22;
  }

  .qf-gen-header p {
    margin: 0 auto;
    max-width: 640px;
    font-size: 0.95rem;
    color: #4b5563;
  }

  .qf-gen-grid {
    max-width: 1280px;
    margin: 1.5rem auto 3rem;
    padding: 0 1rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .qf-gen-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem;
    }
  }

  .qf-panel {
    min-width: 0;
    background: #ffffff;
    border: 1px solid rgba(24, 28, 34, 0.12);
    border-radius: 14px;
    padding: 1.15rem;
    box-shadow: 0 6px 20px rgba(24, 28, 34, 0.04);
  }

  .qf-panel-head {
    margin-bottom: 0.9rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid rgba(24, 28, 34, 0.08);
  }

  .qf-step {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7280;
  }

  .qf-panel-head h2 {
    margin: 0.2rem 0 0;
    font-size: 1.15rem;
    color: #181c22;
  }

  .qf-panel-body :global(.eq-card) {
    max-width: 100%;
    width: 100%;
    margin: 0;
    box-sizing: border-box;
  }
</style>

