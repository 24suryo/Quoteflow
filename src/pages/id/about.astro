---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
---

<BaseLayout
  title="Tentang Kami — QuoteFlow"
  description="QuoteFlow adalah generator kutipan inspiratif dwibahasa dan studio poster minimalis yang dirancang untuk kejernihan pikiran, fokus harian, serta berbagi karya dalam Bahasa Indonesia dan Inggris."
  locale="id"
  alternateUrl="/about/"
>
  <section class="section">
    <div class="container info-wrap">
      <Breadcrumb items={[{ label: 'Beranda', href: '/id/' }, { label: 'Tentang QuoteFlow' }]} />
      <article class="card info-card">
        <h1 class="heading-serif info-h1">Tentang QuoteFlow</h1>
        <p class="info-p">QuoteFlow adalah generator kutipan inspiratif dwibahasa dan studio poster minimalis yang dirancang untuk kejernihan pikiran, fokus harian, serta berbagi karya dalam Bahasa Indonesia dan Inggris.</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .info-wrap { max-width: 820px; }
  .info-card { padding: 2.25rem; }
  .info-h1 { font-size: clamp(1.8rem, 3vw, 2.35rem); margin-bottom: 1rem; }
  .info-p { color: var(--color-charcoal-muted); line-height: 1.75; }
</style>