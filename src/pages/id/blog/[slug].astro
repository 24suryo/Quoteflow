---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { getLatestArticles } from '../../../utils/repository';
import type { Article } from '../../../types';

export function getStaticPaths() {
  const articles = getLatestArticles(20);
  return articles.map((art) => ({
    params: { slug: art.slug.id },
    props: { article: art },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const alternateUrl = `/blog/${article.slug.en}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title.id,
  description: article.excerpt.id,
  datePublished: article.publishedAt,
  inLanguage: 'id',
};
---

<BaseLayout
  title={`${article.title.id} — Jurnal QuoteFlow`}
  description={article.excerpt.id}
  locale="id"
  alternateUrl={alternateUrl}
>
  <section class="section">
    <div class="container post-container">
      <Breadcrumb
        items={[
          { label: 'Beranda', href: '/id/' },
          { label: 'Jurnal', href: '/id/blog/' },
          { label: article.title.id },
        ]}
      />

      <article class="card post-card">
        <span class="post-meta">{article.publishedAt} · {article.readingTimeMinutes} menit baca</span>
        <h1 class="heading-serif post-title">{article.title.id}</h1>
        <p class="post-lead">{article.excerpt.id}</p>
        <div class="post-body">
          <p>{article.content.id}</p>
        </div>
      </article>

      <AdSlot locale="id" slotId="article-inline-slot-id" format="in-article" />
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    </div>
  </section>
</BaseLayout>

<style>
  .post-container { max-width: 820px; }
  .post-card { padding: 2.25rem; }
  .post-meta { font-size: 0.8rem; font-weight: 600; color: var(--color-gold-dark); }
  .post-title { font-size: clamp(1.8rem, 3.2vw, 2.4rem); margin-block: 0.65rem 1rem; }
  .post-lead { font-size: 1.08rem; color: var(--color-charcoal-muted); margin-bottom: 1.5rem; }
  .post-body p { font-size: 1rem; line-height: 1.75; }
</style>