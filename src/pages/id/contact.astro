---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
---

<BaseLayout
  title="Kontak — QuoteFlow"
  description="Punya masukan, saran terjemahan, atau pertanyaan atribusi kutipan? Hubungi tim editorial QuoteFlow melalui hello@quoteflow.pages.dev."
  locale="id"
  alternateUrl="/contact/"
>
  <section class="section">
    <div class="container info-wrap">
      <Breadcrumb items={[{ label: 'Beranda', href: '/id/' }, { label: 'Kontak QuoteFlow' }]} />
      <article class="card info-card">
        <h1 class="heading-serif info-h1">Kontak QuoteFlow</h1>
        <p class="info-p">Punya masukan, saran terjemahan, atau pertanyaan atribusi kutipan? Hubungi tim editorial QuoteFlow melalui hello@quoteflow.pages.dev.</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .info-wrap { max-width: 820px; }
  .info-card { padding: 2.25rem; }
  .info-h1 { font-size: clamp(1.8rem, 3vw, 2.35rem); margin-bottom: 1rem; }
  .info-p { color: var(--color-charcoal-muted); line-height: 1.75; }
</style>